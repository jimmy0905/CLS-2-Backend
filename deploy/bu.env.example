# BU-specific settings for the wtchk_cls canary profile.
#
# Copy these entries into the ignored deploy/profile/wtchk_cls.env file.
# Docker Compose maps the namespaced Azure values to AZURE_CLIENT_ID,
# AZURE_CLIENT_SECRET, and AZURE_TENANT_ID inside backend-wtchk-cls.
# Namespacing on the host prevents one BU from inheriting another BU's secrets.

WTCHK_CLS_AZURE_CLIENT_ID=
WTCHK_CLS_AZURE_CLIENT_SECRET=
WTCHK_CLS_AZURE_TENANT_ID=
WTCHK_CLS_ANALYZE_FEEDBACK_API_URL=
