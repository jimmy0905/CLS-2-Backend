# Shared, mandatory image identities. Resolve and test the v1.7.26 manifest
# digests in the target architecture before putting them here. Do not use tags
# alone in production and do not copy a digest from an untrusted registry.
CUBE_IMAGE_DIGEST=
CUBESTORE_IMAGE_DIGEST=

ANALYTICS_DATABASE_PORT=5432
ANALYTICS_DATABASE_SSL=true
ANALYTICS_DB_QUERY_TIMEOUT_SECONDS=300
ANALYTICS_DRILLDOWN_STATEMENT_TIMEOUT_MS=10000
ANALYTICS_DRILLDOWN_CONCURRENCY=8
ANALYTICS_EXPORT_WORKER_CONCURRENCY=2
ANALYTICS_EXPORT_MAX_OUTSTANDING_PER_USER=2
ANALYTICS_EXPORT_MAX_OUTSTANDING_PROFILE=20

# These are distinct operational namespaces for the four persisted shards.
# See cube/README.md: OSS Cube Store v1.7.26 does not itself support Azure Blob
# persistent storage; these values are reserved for the approved backup or
# Enterprise storage integration.
ANALYTICS_AZURE_BLOB_PREFIX_SHARD_1=clsense/cubestore/shard-1
ANALYTICS_AZURE_BLOB_PREFIX_SHARD_2=clsense/cubestore/shard-2
ANALYTICS_AZURE_BLOB_PREFIX_SHARD_3=clsense/cubestore/shard-3
ANALYTICS_AZURE_BLOB_PREFIX_SHARD_4=clsense/cubestore/shard-4

# Repeat this namespaced block in the ignored environment file for each enabled
# profile. The database principal must be a dedicated LOGIN role with CONNECT,
# USAGE, and SELECT only. Each signing secret must contain at least 32 random
# bytes; secrets must be independent and unique across profiles.
WTCHK_CLS_ANALYTICS_ENABLED=false
WTCHK_CLS_ANALYTICS_DB_USER=
WTCHK_CLS_ANALYTICS_DB_PASSWORD=
WTCHK_CLS_CUBE_API_SECRET=
WTCHK_CLS_ANALYTICS_METADATA_SECRET=
