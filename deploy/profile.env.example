# Profile-specific Docker Compose environment template.
# Copy each enabled profile's block into ignored deploy/profile/<profile>.env.
# Shared BFF/backend API bearer tokens and analysis-feedback endpoints must
# remain isolated per profile. Generate each token with `openssl rand -base64 32`.
# Entra credentials are frontend-only and never belong here.

# CLS profiles
# wtchk_cls
WTCHK_CLS_BACKEND_API_TOKEN=
WTCHK_CLS_ANALYZE_FEEDBACK_API_URL=

