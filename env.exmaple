FASTAPI_DOCS_URL=/docs
FASTAPI_REDOC_URL=/redoc
FASTAPI_OPENAPI_URL=/openapi.json

JWT_SECRET_KEY=your_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_USER=connex_user
DATABASE_PASSWORD=connex_password
DATABASE_HOST=postgres
DATABASE_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@email.com
PGADMIN_DEFAULT_PASSWORD=password

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_ENDPOINT=

EXTRACT_KEYWORDS_MODEL=gpt-4.1-mini
EXTRACT_KEYWORDS_TEMPERATURE=0.0

EXTRACT_TOPICS_MODEL=gpt-4.1-mini
EXTRACT_TOPICS_TEMPERATURE=0.0

EXTRACT_DEPARTMENTS_MODEL=gpt-4.1-mini
EXTRACT_DEPARTMENTS_TEMPERATURE=0.0

EXTRACT_SENTIMENT_MODEL=gpt-4.1-mini
EXTRACT_SENTIMENT_TEMPERATURE=0.0

GENERATE_ACTIONS_MODEL=gpt-4.1
GENERATE_ACTIONS_TEMPERATURE=0.2

GENRATE_EMAIL_MODEL=gpt-4.1
GENRATE_EMAIL_TEMPERATURE=0.25
GENRATE_EMAIL_MAX_TOKEN=2500

GENERATE_STRATEGY_MODEL=gpt-4.1
GENERATE_STRATEGY_TEMPERATURE=0.4
GENERATE_STRATEGY_MAX_TOKENS=1500

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587

# Azure OAuth Configuration
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_REDIRECT_URI=http://localhost:8000/auth/azure/callback
FRONTEND_URL=http://localhost:3000

# Proxy Configuration (optional)
# This will be used for all Azure OAuth requests and JWKS fetching
ASW_PROXY_URL=http://your-proxy-server:port