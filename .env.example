# Shared secrets and integration settings. All non-secret profile identity
# settings are defined directly in docker-compose.yml.
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_PORT=5432
API_JWT_CLOCK_SKEW_SECONDS=30
CORS_ORIGINS=https://<host>

# Frontend JWT public keys and analysis-feedback endpoints belong only in the
# ignored deploy/profile/<profile>.env file. Copy the matching block from
# deploy/profile.env.example there. Do not set generic identity variables or
# ANALYZE_FEEDBACK_API_URL in this shared file.
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_ENDPOINT=
ASW_PROXY_URL=

MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

DATABASE_AUTO_MIGRATE=true
DATABASE_AUTO_GENERATE_MIGRATIONS=false
DATABASE_BOOTSTRAP_SCHEMA=false
SERVER_LOG_LEVEL=INFO
SERVER_LOG_FORMAT=json
# Optional writable path for daily rotated JSON logs. Docker Compose provides a
# default persistent path; leave blank for stdout-only local runs.
SERVER_LOG_FILE=
SERVER_LOG_RETENTION_DAYS=30
DATA_RETENTION_DAYS=30
RETENTION_CHECK_INTERVAL_SECONDS=86400
MAX_WORKER_THREADS=4

# PYTHON TESTING
ANALYTICS_E2E=1
ANALYTICS_E2E_EXPECTED_ROLE=admin
