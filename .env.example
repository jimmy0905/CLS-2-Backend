# Shared secrets and integration settings. Azure OAuth credentials and analysis
# feedback endpoints are profile-specific; all non-secret profile identity
# settings are defined directly in docker-compose.yml.
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_PORT=5432
SESSION_SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=true
CORS_ORIGINS=https://<host>
PUBLIC_BASE_URL=https://<host>

# Azure AD/OAuth credentials and analysis-feedback endpoints are profile-specific.
# Copy entries for enabled profiles from deploy/profile.env.example into this
# untracked .env. Do not set
# generic AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, or
# ANALYZE_FEEDBACK_API_URL: Compose overrides them per service.
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_ENDPOINT=
ASW_PROXY_URL=

MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

DATABASE_AUTO_MIGRATE=true
DATABASE_AUTO_GENERATE_MIGRATIONS=false
DATABASE_BOOTSTRAP_SCHEMA=false
BOOTSTRAP_DEFAULT_ADMIN=false
BOOTSTRAP_DEFAULT_ADMIN_USERNAME=admin
BOOTSTRAP_DEFAULT_ADMIN_PASSWORD=

SERVER_LOG_LEVEL=INFO
SERVER_LOG_FORMAT=json
# Optional writable path for daily rotated JSON logs. Docker stdout remains the default.
SERVER_LOG_FILE=
DATA_RETENTION_DAYS=30
RETENTION_CHECK_INTERVAL_SECONDS=86400
MAX_WORKER_THREADS=4
