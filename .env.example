# Shared secrets and integration settings. All non-secret profile identity
# settings are defined directly in docker-compose.yml.
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_PORT=5432
CORS_ORIGINS=https://<host>

# Profile-specific backend bearer credentials and analysis-feedback endpoints
# belong only in ignored deploy/profile/<profile>.env files. Copy the matching
# block from deploy/profile.env.example there; do not set them in this file.
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_ENDPOINT=
ASW_PROXY_URL=

MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

DATABASE_AUTO_MIGRATE=true
DATABASE_AUTO_GENERATE_MIGRATIONS=false
DATABASE_BOOTSTRAP_SCHEMA=false
SERVER_LOG_LEVEL=INFO
SERVER_LOG_FORMAT=json
# Optional writable path for daily rotated JSON logs. Docker Compose provides a
# default persistent path; leave blank for stdout-only local runs.
SERVER_LOG_FILE=
SERVER_LOG_RETENTION_DAYS=30
DATA_RETENTION_DAYS=30
RETENTION_CHECK_INTERVAL_SECONDS=86400
MAX_WORKER_THREADS=4

# n8n execution collector. Create an API key in n8n Settings > n8n API and
# keep this value only in the ignored deployment environment.
N8N_API_BASE_URL=http://n8n:5678/api/v1
N8N_API_KEY=
N8N_POLL_INTERVAL_SECONDS=30
N8N_INITIAL_BACKFILL_HOURS=720
N8N_HTTP_TIMEOUT_SECONDS=10
N8N_WORKFLOW_REFRESH_SECONDS=3600
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push

# PYTHON TESTING
ANALYTICS_E2E=1
ANALYTICS_E2E_EXPECTED_ROLE=admin
