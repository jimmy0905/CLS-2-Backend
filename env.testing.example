# Copy the values needed for local live testing into .env.
# Keep real credentials out of this example file.

# Explicitly enable the live analytics tests.
ANALYTICS_E2E=1
ANALYTICS_E2E_BASE_URL=http://localhost:8000
ANALYTICS_E2E_API_PREFIX=
# Supply the matching profile's static API bearer token.
ANALYTICS_E2E_API_TOKEN=

# Query context used by the dashboard scenarios.
ANALYTICS_E2E_TIMEZONE=Asia/Hong_Kong
ANALYTICS_E2E_FROM_DATE=2020-01-01T00:00:00Z
ANALYTICS_E2E_TO_DATE=2030-01-01T00:00:00Z
ANALYTICS_E2E_TIMEOUT=30
ANALYTICS_E2E_LOG_MAX_BYTES=50000
