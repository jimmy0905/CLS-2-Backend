# Copy the values needed for local live testing into .env.
# Keep real credentials out of this example file.

# Explicitly enable the live analytics tests.
ANALYTICS_E2E=1
ANALYTICS_E2E_BASE_URL=http://localhost:8000
ANALYTICS_E2E_API_PREFIX=
ANALYTICS_E2E_EXPECTED_ROLE=admin

# The runner first checks ANALYTICS_E2E_TOKEN. Otherwise it uses these
# bootstrap credentials when they are available in the loaded environment.
ANALYTICS_E2E_TOKEN=
ANALYTICS_E2E_USERNAME=
ANALYTICS_E2E_PASSWORD=
BOOTSTRAP_DEFAULT_ADMIN_USERNAME=admin
BOOTSTRAP_DEFAULT_ADMIN_PASSWORD=

# Query context used by the dashboard scenarios.
ANALYTICS_E2E_TIMEZONE=Asia/Hong_Kong
ANALYTICS_E2E_FROM_DATE=2020-01-01T00:00:00Z
ANALYTICS_E2E_TO_DATE=2030-01-01T00:00:00Z
ANALYTICS_E2E_TIMEOUT=30
ANALYTICS_E2E_LOG_MAX_BYTES=50000

# Optional old-deployment comparison. Set both variables to enable the
# legacy comparison test; the legacy service must expose /dashboard/*.
ANALYTICS_E2E_COMPARISON_MANIFEST=
ANALYTICS_E2E_LEGACY_BASE_URL=
